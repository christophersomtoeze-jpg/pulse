# Browser-safe Supabase configuration. Use the Project Publishable key (sb_publishable_...).
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Legacy name accepted temporarily for existing deployments; prefer the publishable key above.
# VITE_SUPABASE_ANON_KEY=YOUR_LEGACY_ANON_KEY

# OAuth client IDs are public identifiers used only to start the provider flow.
# Keep all client secrets server-side in Supabase Edge Function secrets.
VITE_SLACK_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
VITE_MICROSOFT_CLIENT_ID=
VITE_JIRA_CLIENT_ID=

# Optional browser push public key. Keep the private key server-side.
VITE_VAPID_PUBLIC_KEY=
