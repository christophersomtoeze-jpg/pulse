# ============================================================
# PULSE — Environment Variables
# Copy this file to .env.local for local development.
# Never commit real secrets. Set production secrets in
# Supabase Dashboard → Project Settings → Edge Functions → Secrets
# and in your hosting provider (Vercel / Netlify / Render).
# ============================================================

# ---- Frontend (Vite) — these are public ----
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Alternative name some builds use:
# VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key_here

# Optional: show a custom support email in the UI
VITE_SUPPORT_EMAIL=support@yourdomain.com

# ---- Supabase Edge Function secrets (set with: supabase secrets set KEY=value) ----
# These never go in the frontend .env
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# AI (server-side only)
ANTHROPIC_API_KEY=sk-ant-...
# or OPENAI_API_KEY=sk-...

# Stripe (server-side only)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_BUSINESS=price_...

# Optional integrations
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=

# App URL (used for OAuth redirects and emails)
APP_URL=https://your-domain.com
